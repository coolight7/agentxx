@PACKAGE_INIT@

# cxx_utilxx_base 包配置: 解析依赖并导入导出目标
#   cxx_utilxx_base_shared  (动态库)
#   cxx_utilxx_base_static  (静态库)
# 两者都带完整 INTERFACE 依赖, 处理方按需选择变体即可。
#
# 依赖查找顺序 (处理方须遵守): 处理方先在本机查找条件依赖 (io_uring), 再
# find_package(cxx_utilxx_base) —— 导出目标会校验其 INTERFACE 引用的目标
# (PkgConfig::uring) 是否已存在, 顺序颠倒会报目标不存在。

include(CMakeFindDependencyMacro)

find_dependency(Boost CONFIG)
find_dependency(fmt)
find_dependency(simdjson)
if (@CXX_UTILXX_BASE_ENABLE_CHARSET@)
  # iconv 必须显式 CONFIG 模式 (见 CMakeLists.txt 说明), 小写包名匹配
  # libiconv-native 安装的 iconvConfig.cmake
  find_dependency(iconv CONFIG)
  find_dependency(uchardet)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/cxx_utilxx_baseTargets.cmake")

# 条件依赖开关 (构建信息, 供处理方核对): 开启时导出接口以目标名 PkgConfig::uring
# 声明该依赖, 处理方须在 find_package(cxx_utilxx_base) 之前先
#   pkg_check_modules(uring REQUIRED IMPORTED_TARGET liburing)
# (宿主 superbuild 内处理方按其顶层开关判断, 与本库
#  构建开关 CXX_UTILXX_BASE_LINUX_IO_URING_SUPPORTED 同源)
set(cxx_utilxx_base_LINUX_IO_URING_SUPPORTED "@CXX_UTILXX_BASE_LINUX_IO_URING_SUPPORTED@")

check_required_components(cxx_utilxx_base)
