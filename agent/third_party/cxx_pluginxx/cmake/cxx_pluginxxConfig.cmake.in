@PACKAGE_INIT@

# cxx_pluginxx 包配置: 解析依赖并导入导出目标
#   cxx_pluginxx_shared  (动态库)
#   cxx_pluginxx_static  (静态库)
#
# 依赖查找顺序 (处理方须遵守): cxx_utilxx_base 的条件依赖 (io_uring) 需先在本机
# 查找, 再 find_package(cxx_pluginxx) (其内部 find_dependency(cxx_utilxx_base)
# 会校验 PkgConfig::uring 是否存在)。

include(CMakeFindDependencyMacro)

find_dependency(Boost CONFIG)
find_dependency(fmt)
# 插件清单 (plugin.yaml) 解析依赖 yaml-cpp (见 pluginxx/host/manifest.h)
find_dependency(yaml-cpp)
find_dependency(cxx_utilxx_base)

include("${CMAKE_CURRENT_LIST_DIR}/cxx_pluginxxTargets.cmake")

check_required_components(cxx_pluginxx)
