@PACKAGE_INIT@

# cxx_utilxx 包配置: 解析依赖并导入导出目标
#   cxx_utilxx_shared  (动态库)
#   cxx_utilxx_static  (静态库)
#
# 依赖查找顺序 (处理方须遵守): 处理方先在本机查找条件依赖 (io_uring 属
# cxx_utilxx_base, HyperScan 属本库), 再 find_package(cxx_utilxx) —— 导出目标会
# 校验其 INTERFACE 引用的目标 (PkgConfig::uring / PkgConfig::hyperscan) 是否已
# 存在, 顺序颠倒会报目标不存在。

include(CMakeFindDependencyMacro)

# 依赖库本体 (其条件依赖 io_uring 已由处理方先按开关查找)
find_dependency(cxx_utilxx_base)
find_dependency(Boost CONFIG)
if (@CXX_UTILXX_ENABLE_BOOST_PROCESS@)
  find_dependency(Boost CONFIG COMPONENTS process)
endif ()
find_dependency(OpenSSL)
find_dependency(SQLite3 CONFIG)
find_dependency(fmt)
find_dependency(html2md)

include("${CMAKE_CURRENT_LIST_DIR}/cxx_utilxxTargets.cmake")

# 条件依赖开关 (构建信息, 供处理方核对): 开启时导出接口以目标名
# PkgConfig::hyperscan + 裸库名 hs_runtime 声明该依赖, 处理方须在
# find_package(cxx_utilxx) 之前先
#   pkg_check_modules(hyperscan REQUIRED IMPORTED_TARGET libhs)
# (宿主 superbuild 内处理方按其顶层开关判断, 与本库构建开关
#  CXX_UTILXX_ENABLE_HYPERSCAN 同源; hs_runtime 由本库 INTERFACE 的 link 目录解析)
set(cxx_utilxx_ENABLE_HYPERSCAN "@CXX_UTILXX_ENABLE_HYPERSCAN@")

check_required_components(cxx_utilxx)
